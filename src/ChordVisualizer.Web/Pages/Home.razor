@page "/"
@using AppliedHyperkinetics.ChordVisualizer.Core
@using AppliedHyperkinetics.ChordVisualizer.Core.Voicings
@inject IChordVoicingProvider VoicingProvider

<PageTitle>Chord Visualizer</PageTitle>

<div class="chord-visualizer-page" @onclick="DismissAllHelpTooltips">
<h1><img src="Logo_ico.png" alt="Chord Visualizer logo" class="logo"/>Chord Visualizer</h1>
<form class="sticky-chord-controls" @onsubmit="ShowChord" @onsubmit:preventDefault>
    <div class="chord-entry">
        <div class="label-help-row">
            <label for="chord-name">Chord</label>
            <button type="button"
                    class="info-button"
                    aria-label="About chord names"
                    aria-expanded="@ShowChordHelp"
                    aria-controls="chord-name-help"
                    @onclick="ToggleChordHelp"
                    @onclick:stopPropagation>i</button>
            @if (ShowChordHelp)
            {
                <div id="chord-name-help" class="help-popover chord-help-popover" role="note" @onclick:stopPropagation>
                    <button type="button"
                            class="help-close"
                            aria-label="Close chord name help"
                            @onclick="() => ShowChordHelp = false">×</button>
                    <p>Enter a note name followed by an optional chord type:</p>
                    <ul>
                        <li>Roots: A–G, optionally with <code>#</code> or <code>b</code> (for example, <code>C#</code> or <code>Db</code>). Write <code>Db</code> for D-flat; <code>Dflat</code> is not supported.</li>
                        <li>Common types: major (<code>C</code> or <code>Cmaj</code>), minor (<code>Dm</code> or <code>Dmin</code>), seventh (<code>G7</code>), major seventh (<code>Fmaj7</code>), minor seventh (<code>Am7</code>), add-nine (<code>Cadd9</code>), or suspended fourth (<code>Dsus4</code>).</li>
                        <li>Slash chords specify a bass note, for example <code>C/E</code>.</li>
                    </ul>
                    <p>Other chord types may show curated voicings when they are available in the chord library.</p>
                </div>
            }
        </div>
        <div class="chord-entry-row">
            <input id="chord-name" @bind="ChordText" @bind:event="oninput" placeholder="e.g. C/D or Fmaj7" />
            <button type="submit">Show voicings</button>
        </div>
    </div>

    <div class="fret-span-control">
        <div class="label-help-row">
            <label for="fret-span">Fret span</label>
            <button type="button"
                    class="info-button"
                    aria-label="About fret span"
                    aria-expanded="@ShowFretSpanHelp"
                    aria-controls="fret-span-help"
                    @onclick="ToggleFretSpanHelp"
                    @onclick:stopPropagation>i</button>
            @if (ShowFretSpanHelp)
            {
                <div id="fret-span-help" class="help-popover" role="note" @onclick:stopPropagation>
                    <button type="button"
                            class="help-close"
                            aria-label="Close fret span help"
                            @onclick="() => ShowFretSpanHelp = false">×</button>
                    <p>Fret span limits how far apart the fretted notes in a voicing can be. A span of 4 allows notes across four consecutive fret positions, such as frets 1–4. Open strings do not count toward the span.</p>
                </div>
            }
        </div>
        <input id="fret-span" type="number" min="1" max="12" step="1" @bind="FretSpan" @bind:event="oninput" />
    </div>

    <fieldset class="fret-range-filter">
        <legend>
            <span class="label-help-row">
                Lowest starting fret
                <button type="button"
                        class="info-button"
                        aria-label="About lowest starting fret"
                        aria-expanded="@ShowLowestStartingFretHelp"
                        aria-controls="lowest-starting-fret-help"
                        @onclick="ToggleLowestStartingFretHelp"
                        @onclick:stopPropagation>i</button>
                @if (ShowLowestStartingFretHelp)
                {
                    <span id="lowest-starting-fret-help" class="help-popover" role="note" @onclick:stopPropagation>
                        <button type="button"
                                class="help-close"
                                aria-label="Close lowest starting fret help"
                                @onclick="() => ShowLowestStartingFretHelp = false">×</button>
                        <span>Filters by the starting fret shown on each voicing diagram, not by the lowest-pitched note. The From and To limits are inclusive; open-position voicings commonly start at fret 1.</span>
                    </span>
                }
            </span>
        </legend>
        <label for="minimum-lowest-fret">
            <span>From</span>
            <input id="minimum-lowest-fret" type="number" min="0" max="22" step="1" @bind="MinimumLowestFret" @bind:event="oninput" />
        </label>
        <label for="maximum-lowest-fret">
            <span>To</span>
            <input id="maximum-lowest-fret" type="number" min="0" max="22" step="1" @bind="MaximumLowestFret" @bind:event="oninput" />
        </label>
    </fieldset>

    <fieldset class="display-controls">
        <legend>Display</legend>
        <div class="display-help-control">
            <label for="include-generated">
                <input id="include-generated" type="checkbox" @bind="IncludeGeneratedVoicings" />
                <span>Include generated voicings</span>
            </label>
            <button type="button"
                    class="info-button"
                    aria-label="About generated voicings"
                    aria-expanded="@ShowGeneratedVoicingsHelp"
                    aria-controls="generated-voicings-help"
                    @onclick="ToggleGeneratedVoicingsHelp"
                    @onclick:stopPropagation>i</button>
            @if (ShowGeneratedVoicingsHelp)
            {
                <div id="generated-voicings-help" class="help-popover" role="note" @onclick:stopPropagation>
                    <button type="button"
                            class="help-close"
                            aria-label="Close generated voicings help"
                            @onclick="() => ShowGeneratedVoicingsHelp = false">×</button>
                    <p>A curated library provides common chord voicings. Turn this on to expand the dsiplayed results with voicings generated from the chord's notes. Choose <strong>Common</strong> for a more playable subset or <strong>All</strong> to include every generated voicing that meets the fret filters.</p>
                </div>
            }
        </div>
        <div class="display-help-control">
            <label for="show-note-names">
                <input id="show-note-names" type="checkbox" @bind="ShowNoteNames" />
                <span>Note names</span>
            </label>
            <button type="button"
                    class="info-button"
                    aria-label="About note names"
                    aria-expanded="@ShowNoteNamesHelp"
                    aria-controls="note-names-help"
                    @onclick="ToggleNoteNamesHelp"
                    @onclick:stopPropagation>i</button>
            @if (ShowNoteNamesHelp)
            {
                <div id="note-names-help" class="help-popover" role="note" @onclick:stopPropagation>
                    <button type="button"
                            class="help-close"
                            aria-label="Close note names help"
                            @onclick="() => ShowNoteNamesHelp = false">×</button>
                    <p>Toggle between showing note names and finger positions on the chord diagram. Finger positions appear when fingering information is available for that voicing.</p>
                </div>
            }
        </div>
    </fieldset>

    <fieldset class="voicing-source-controls">
        <legend>Generated voicings</legend>
        <div class="display-help-control">
            <label for="generation-scope">
                <span>Scope</span>
                <select id="generation-scope" @bind="GenerationScope" disabled="@(!IncludeGeneratedVoicings)">
                    <option value="@VoicingGenerationScope.Common">Common</option>
                    <option value="@VoicingGenerationScope.All">All</option>
                </select>
            </label>
            <button type="button"
                    class="info-button"
                    aria-label="About generated voicing scope"
                    aria-expanded="@ShowGenerationScopeHelp"
                    aria-controls="generation-scope-help"
                    @onclick="ToggleGenerationScopeHelp"
                    @onclick:stopPropagation>i</button>
            @if (ShowGenerationScopeHelp)
            {
                <div id="generation-scope-help" class="help-popover" role="note" @onclick:stopPropagation>
                    <button type="button"
                            class="help-close"
                            aria-label="Close generated voicing scope help"
                            @onclick="() => ShowGenerationScopeHelp = false">×</button>
                    <p><strong>Common</strong> 2. <strong>All</strong> includes every generated voicing that matches the selected chord and filters. This setting only affects generated voicings; curated voicings are unchanged. It applies when <strong>Include generated voicings</strong> is on.</p>
                </div>
            }
        </div>
    </fieldset>

    <fieldset class="triad-controls">
        <legend>Triads</legend>
        <div class="display-help-control">
            <label for="triad-only">
                <input id="triad-only" type="checkbox" @bind="TriadOnly" @bind:after="OnTriadOnlyChanged" />
                <span>Triads only</span>
            </label>
            <button type="button"
                    class="info-button"
                    aria-label="About triad filtering"
                    aria-expanded="@ShowTriadHelp"
                    aria-controls="triad-help"
                    @onclick="ToggleTriadHelp"
                    @onclick:stopPropagation>i</button>
            @if (ShowTriadHelp)
            {
                <div id="triad-help" class="help-popover" role="note" @onclick:stopPropagation>
                    <button type="button"
                            class="help-close"
                            aria-label="Close triad filtering help"
                            @onclick="() => ShowTriadHelp = false">×</button>
                    <p>Shows only voicings with exactly three chord tones, played on three adjacent strings. Enabling this also turns on <strong>Include generated voicings</strong> so generated triads can appear. Use the inversion menu to choose which chord tone is in the bass.</p>
                </div>
            }
        </div>
        <label for="triad-inversion">
            <span>Inversion</span>
            <select id="triad-inversion" @bind="SelectedTriadInversion" disabled="@(!TriadOnly)">
                <option value="">Any</option>
                <option value="@TriadInversion.RootPosition">Root position</option>
                <option value="@TriadInversion.FirstInversion">First inversion</option>
                <option value="@TriadInversion.SecondInversion">Second inversion</option>
            </select>
        </label>
    </fieldset>
</form>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p role="alert">@ErrorMessage</p>
}

@if (VoicingFamilies is { Count: > 0 })
{
    <table class="voicing-families-table">
        <thead>
            <tr>
                <th scope="col">Best voicing</th>
                <th scope="col">Similar voicings</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var family in VoicingFamilies)
            {
                var expanded = ExpandedFamilies.Contains(family);
                <tr>
                    <td>
                        <h2>@family.BestVoicing.Chord.Text (@family.BestVoicing.Label)</h2>
                        <div class="chord-diagram">@((MarkupString)SvgChordDiagramRenderer.Render(family.BestVoicing, ShowNoteNames))</div>
                        @if (family.Alternatives.Count > 0)
                        {
                            <button type="button"
                                    aria-expanded="@expanded"
                                    @onclick="() => ToggleAlternatives(family)">
                                @(expanded ? "Hide similar voicings" : $"Show {family.Alternatives.Count} similar voicings")
                            </button>
                        }
                    </td>
                    <td>
                        @if (expanded)
                        {
                            <div class="voicing-alternatives">
                                @foreach (var alternative in family.Alternatives)
                                {
                                    <section>
                                        <h3>@alternative.Label</h3>
                                        <div class="chord-diagram">@((MarkupString)SvgChordDiagramRenderer.Render(alternative, ShowNoteNames))</div>
                                    </section>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (VoicingFamilies is { Count: 0 })
{
    <p>No voicings match these filters.</p>
}
</div>

@code {
    private string ChordText { get; set; } = "C";
    private bool ShowChordHelp { get; set; }
    private bool ShowGeneratedVoicingsHelp { get; set; }
    private int FretSpan { get; set; } = 4;
    private bool ShowFretSpanHelp { get; set; }
    private int MinimumLowestFret { get; set; }
    private int MaximumLowestFret { get; set; } = 12;
    private bool ShowLowestStartingFretHelp { get; set; }
    private bool IncludeGeneratedVoicings { get; set; }
    private VoicingGenerationScope GenerationScope { get; set; } = VoicingGenerationScope.Common;
    private bool ShowGenerationScopeHelp { get; set; }
    private bool TriadOnly { get; set; }
    private bool ShowTriadHelp { get; set; }
    private TriadInversion? SelectedTriadInversion { get; set; }
    private bool ShowNoteNames { get; set; }
    private bool ShowNoteNamesHelp { get; set; }
    private IReadOnlyList<ChordVoicingFamily>? VoicingFamilies { get; set; }
    private HashSet<ChordVoicingFamily> ExpandedFamilies { get; } = new();
    private string? ErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        ShowChord();
    }

    private void ToggleFretSpanHelp()
    {
        ShowFretSpanHelp = !ShowFretSpanHelp;
    }

    private void ToggleChordHelp()
    {
        ShowChordHelp = !ShowChordHelp;
    }

    private void ToggleLowestStartingFretHelp()
    {
        ShowLowestStartingFretHelp = !ShowLowestStartingFretHelp;
    }

    private void ToggleGeneratedVoicingsHelp()
    {
        ShowGeneratedVoicingsHelp = !ShowGeneratedVoicingsHelp;
    }

    private void ToggleGenerationScopeHelp()
    {
        ShowGenerationScopeHelp = !ShowGenerationScopeHelp;
    }

    private void ToggleNoteNamesHelp()
    {
        ShowNoteNamesHelp = !ShowNoteNamesHelp;
    }

    private void ToggleTriadHelp()
    {
        ShowTriadHelp = !ShowTriadHelp;
    }

    private void DismissAllHelpTooltips()
    {
        ShowChordHelp = false;
        ShowFretSpanHelp = false;
        ShowLowestStartingFretHelp = false;
        ShowGeneratedVoicingsHelp = false;
        ShowNoteNamesHelp = false;
        ShowGenerationScopeHelp = false;
        ShowTriadHelp = false;
    }

    private void OnTriadOnlyChanged()
    {
        if (TriadOnly)
            IncludeGeneratedVoicings = true;
    }

    private void ShowChord()
    {
        try
        {
            FretSpan = Math.Clamp(FretSpan, 1, 12);
            MinimumLowestFret = Math.Clamp(MinimumLowestFret, 0, 22);
            MaximumLowestFret = Math.Clamp(MaximumLowestFret, 0, 22);
            if (MinimumLowestFret > MaximumLowestFret)
                throw new ArgumentException("The lowest-fret range must start at or below its end.");

            var chord = ChordSymbol.Parse(ChordText);
            var curatedVoicings = GetCuratedVoicings(chord);
            var generatedVoicings = !IncludeGeneratedVoicings || chord.Quality == ChordQuality.Other
                ? Array.Empty<ChordVoicing>()
                : new VoicingGenerator { MaxFretSpan = FretSpan - 1 }
                    .GenerateVoicingFamilies(
                    chord,
                    MinimumLowestFret,
                    MaximumLowestFret,
                    scope: GenerationScope,
                    triadOnly: TriadOnly,
                    inversion: TriadOnly ? SelectedTriadInversion : null)
                    .SelectMany(family => new[] { family.BestVoicing }.Concat(family.Alternatives));
            VoicingFamilies = ChordVoicingFamilyBuilder.Build(generatedVoicings, curatedVoicings);

            ExpandedFamilies.Clear();
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            VoicingFamilies = null;
            ExpandedFamilies.Clear();
            ErrorMessage = ex.Message;
        }
    }

    private IReadOnlyList<ChordVoicing> GetCuratedVoicings(ChordSymbol chord)
    {
        return VoicingProvider.GetVoicings(chord)
            .Where(voicing => voicing.DisplayStartFret >= MinimumLowestFret &&
                              voicing.DisplayStartFret <= MaximumLowestFret)
            .Where(IsWithinFretSpan)
            .Where(voicing =>
                !TriadOnly ||
                ChordVoicingFilters.MatchesTriad(
                    voicing,
                    SelectedTriadInversion))
            .ToList();
    }

    private bool IsWithinFretSpan(ChordVoicing voicing)
    {
        var frets = voicing.Positions
            .Where(position => position.State == StringPlayState.Fretted)
            .Select(position => position.Fret!.Value)
            .ToArray();

        return frets.Length == 0 || frets.Max() - frets.Min() <= FretSpan - 1;
    }

    private void ToggleAlternatives(ChordVoicingFamily family)
    {
        if (!ExpandedFamilies.Add(family))
        {
            ExpandedFamilies.Remove(family);
        }
    }
}
